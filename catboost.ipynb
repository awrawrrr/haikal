    "\n",
    "    model, result, importance, top_features = train_model(\n",
    "        subset,\n",
    "        name=dh_name,\n",
    "        shap_flag=True\n",
    "    )\n",
    "\n",
    "    all_result[dh_name] = {\n",
    "        'model': model,\n",
    "        'result': result,\n",
    "        'importance': importance,\n",
    "        'top_features': top_features\n",
    "    }"
